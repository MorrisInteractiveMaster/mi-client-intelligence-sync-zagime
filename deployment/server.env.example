# Local-only test server configuration
# M8 staging uses separately approved values, never activates on merge:
# MORRIS_ENTRA_TENANT_ID=OWNER_VERIFIED_ENTRA_TENANT_UUID
# MORRIS_ENTRA_CLIENT_ID=OWNER_VERIFIED_MICROSOFT_CLIENT_UUID
# MORRIS_DASHBOARD_TENANT_ID=synthetic-zagime
# STAGING_PREVIEW_ONLY=true
# SERVE_STAGING_FRONTEND=true
# See docs/m8-launch.md for exact flags, image and independent launch phases.
# BACKEND_MODE is unset by default. Use emulator only with both loopback emulators running.
# BACKEND_MODE=emulator
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=demo-mi-security
# PORT=8081
# Production: attached ADC identity only, after owner approval and deployed-rules verification.
# ENABLE_LIVE_FIREBASE and FIRESTORE_RULES_VERIFIED are intentionally unset.

# Staging remains disabled: use reviewed named database configuration only.
# BACKEND_MODE=staging
# STAGING_FIREBASE_PROJECT_ID=morris-client-dash-zagime
# ENABLE_SYNTHETIC_STAGING=false
# ENABLE_LIVE_FIREBASE=false
# FIRESTORE_RULES_VERIFIED=false

# FIRESTORE_DATABASE_ID=mi-client-staging
# STAGING_DATABASE_UID=6d09ea71-f495-44a5-94a6-732ed1c47d88
# STAGING_IAM_VERIFIED=false
# STAGING_SERVICE_ACCOUNT_EMAIL=mi-client-staging-api@morris-client-dash-zagime.iam.gserviceaccount.com
