// Model: all /tenants/{tenantId}/... documents are server-only in M3.
// Memberships, source time, allocations, audits and published projections have no browser access.
// No authenticated, anonymous, owner or administrator exceptions are approved.
// Backend SDKs bypass these rules and MUST enforce authorization independently.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
