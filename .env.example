# Protected mode is OFF. No live configuration/credentials were entered in M4.
VITE_ENABLE_SECURE_API=false
# Staging image uses same-origin API and this owner-verified public tenant UUID:
# VITE_MORRIS_ENTRA_TENANT_ID=OWNER_VERIFIED_ENTRA_TENANT_UUID
# Set only after owner approval and synthetic staging verification:
# VITE_SECURE_API_ORIGIN=https://OWNER_APPROVED_API_ORIGIN
# VITE_SECURE_TENANT_ID=OWNER_APPROVED_TENANT_ID
# VITE_FIREBASE_API_KEY=OWNER_VERIFIED_PUBLIC_WEB_API_KEY
# No OAuth client secrets/refresh tokens, service-account keys or private data here.
# Existing staging: morris-client-dash-zagime / mi-client-staging / northamerica-northeast1.
# Production (default) is prohibited; active workspace requires explicit named selection.
# Server live flags remain unset: ENABLE_LIVE_FIREBASE and FIRESTORE_RULES_VERIFIED.
# Hosted config must come from the independently approved environment.
# VITE_FIREBASE_PROJECT_ID=OWNER_VERIFIED_ENVIRONMENT_PROJECT_ID
# VITE_FIREBASE_APP_ID=OWNER_VERIFIED_WEB_APP_ID
# VITE_FIREBASE_AUTH_DOMAIN=OWNER_VERIFIED_AUTH_DOMAIN
# VITE_AUTH_EMULATOR is for local demo-mi-security only; never enable in hosted builds.
# Same-project staging uses the same approved public Firebase Auth config; no browser Firestore access.
# Backend database selection belongs only in server configuration; see deployment/server.env.example.
